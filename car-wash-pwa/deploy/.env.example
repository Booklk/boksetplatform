# ────────────────────────────────────────────────────────────────────────
#  Jdawil production environment.
#  Copy to `.env` next to docker-compose.yml and fill in real values.
#  NEVER commit the real .env to git.
#
#  Quickstart secret generation:
#    JWT_SECRET / HEALTH_CHECK_TOKEN:
#       node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#    ENCRYPTION_KEY (must be 64 hex chars = 32 bytes):
#       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    VAPID keys:
#       npx web-push generate-vapid-keys
# ────────────────────────────────────────────────────────────────────────

# ─── REQUIRED — server won't boot without these ───────────────────────────
POSTGRES_PASSWORD=        # 32+ random chars, generated as above
JWT_SECRET=               # 48+ random chars
ENCRYPTION_KEY=           # MUST be 64 hex chars (32 bytes)
HEALTH_CHECK_TOKEN=       # 24+ random chars — used by /api/health probes

# ─── Public URLs ──────────────────────────────────────────────────────────
DOMAIN=jdawil.sa
BASE_URL=https://jdawil.sa
PLATFORM_DOMAINS=jdawil.sa,www.jdawil.sa
VITE_API_URL=/api          # same-origin in production

# ─── Postgres (override if you want a different DB / user) ────────────────
POSTGRES_USER=jdawil
POSTGRES_DB=jdawil

# ─── WhatsApp (platform-level — for OTP + shared sender) ──────────────────
# Get these from developers.facebook.com → your app → WhatsApp → API Setup.
# Vendors connect their own credentials separately via /vendor/whatsapp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ─── Payments (Moyasar) ───────────────────────────────────────────────────
# Live secret key from moyasar.com (sk_live_...). Used for platform-level
# subscription renewals and as a fallback when a vendor hasn't set their own.
MOYASAR_API_KEY=
MOYASAR_WEBHOOK_SECRET=   # set in Moyasar dashboard, paste here

# ─── Web Push (vendor browser notifications) ──────────────────────────────
# Generate once: `npx web-push generate-vapid-keys`. Keep both keys forever
# — rotating breaks every saved subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:support@jdawil.sa

# ─── Observability (Sentry) ───────────────────────────────────────────────
# Free tier (5K events/month) is enough to start. Use the same DSN on
# server and client; Sentry separates them by `release`.
SENTRY_DSN=
SENTRY_RELEASE=             # auto-set from GIT_COMMIT below if blank
GIT_COMMIT=                 # set by deploy.sh to `git rev-parse --short HEAD`

# ─── AI bot (OpenAI — optional, only if you sell the AI add-on) ──────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Storage (s3 OR local) ────────────────────────────────────────────────
# STORAGE_PROVIDER=local keeps uploads on the api container's /app/uploads
# (mounted to host ./data/uploads). Fine up to ~500 vendors.
# Switch to s3 + Cloudflare R2 once you outgrow that.
STORAGE_PROVIDER=local
S3_ENDPOINT=                # e.g. https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=                  # e.g. jdawil-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=              # e.g. https://cdn.jdawil.sa
S3_BACKUP_BUCKET=           # separate bucket recommended for DB backups

# ─── Firebase (client only — for FCM push + phone auth) ───────────────────
# Get these from Firebase Console → Project Settings → "Your apps" → Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_VAPID_PUBLIC_KEY=      # mirror of VAPID_PUBLIC_KEY above (client-side)
VITE_SENTRY_DSN=            # mirror of SENTRY_DSN (client-side)
VITE_MOYASAR_PUBLISHABLE_KEY= # pk_live_... from Moyasar (safe to bundle)

# ─── Tuning (safe defaults — override only if you know why) ───────────────
DB_POOL_MAX=100
WHATSAPP_QUEUE_CONCURRENT=8
SLOW_REQUEST_MS=1000

# ─── Maintenance mode ─────────────────────────────────────────────────────
# Set to "1" to put the platform in read-only mode (writes return 503).
# Use during DB migrations or to stop the bleeding mid-incident.
MAINTENANCE_MODE=
