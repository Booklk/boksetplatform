# ⚠️  Change EVERY value below before using in production.
# Validation runs at boot (lib/validate-env.ts) — it exits on bad values.

DATABASE_URL=postgresql://user:password@localhost:5432/jadawel
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=INVALID_change_to_a_long_random_secret_min_32_chars
# MUST be exactly 64 hex chars in production (32 bytes AES key).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=INVALID_change_to_64_hex_chars_in_production
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
BASE_URL=http://localhost:3001

# Public domain (used in sitemap, WhatsApp tracking links, etc.)
DOMAIN=jadawel.sa

# How many reverse-proxy hops to trust for req.ip / rate limiting.
# 1 for a single LB in front of Node; adjust per infra.
TRUST_PROXY=1

# ─── WhatsApp Business Cloud API (REQUIRED in production) ─────────────────
# Without these, OTP and password-reset messages are not sent — auth breaks.
WHATSAPP_TOKEN=your_meta_access_token
WHATSAPP_PHONE_ID=your_phone_number_id

# ─── Platform subscription gateway (Moyasar) ──────────────────────────────
# Used for the platform's own subscription charges to vendors.
MOYASAR_API_KEY=sk_test_xxxx
# HMAC secret from the Moyasar dashboard. REQUIRED in production so webhook
# signatures are actually verified; dev mode skips verification.
MOYASAR_WEBHOOK_SECRET=your_moyasar_webhook_hmac_secret

# ─── Custom domain support ────────────────────────────────────────────────
# Comma-separated list of platform's own domains (won't trigger vendor detection)
PLATFORM_DOMAINS=jadawel.sa,localhost,127.0.0.1

# ─── OpenAI (Copilot + Daily Brief) ───────────────────────────────────────
# Optional: Copilot and Morning Brief gracefully degrade without it.
OPENAI_API_KEY=sk-your_openai_api_key

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# Optional: push notifications are disabled if missing.
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=admin@jadawel.sa

# ─── Sentry Error Tracking (sentry.io) ────────────────────────────────────
SENTRY_DSN=
