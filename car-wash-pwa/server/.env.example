DATABASE_URL=postgresql://user:password@localhost:5432/jdawil
JWT_SECRET=change_this_to_a_long_random_secret_key_minimum_32_chars
ENCRYPTION_KEY=change_this_32_char_hex_key_for_aes256
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
BASE_URL=http://localhost:3001

# Public domain (used in sitemap, WhatsApp tracking links, etc.)
DOMAIN=jdawil.sa

# WhatsApp Business Cloud API
WHATSAPP_TOKEN=your_meta_access_token
WHATSAPP_PHONE_ID=your_phone_number_id

# Moyasar Payment Gateway (platform-level key)
MOYASAR_API_KEY=sk_test_xxxx

# Custom Domain Support
# Comma-separated list of platform's own domains (won't trigger vendor detection)
PLATFORM_DOMAINS=jdawil.sa,localhost,127.0.0.1

# OpenAI (AI Business Advisor)
OPENAI_API_KEY=sk-your_openai_api_key

# Web Push (VAPID) — Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=admin@jdawil.sa
