    "db:deploy": "npm run db:migrate && npm run db:seed:plans",
    "db:studio": "drizzle-kit studio",
    "pre-launch": "tsx scripts/pre-launch-check.ts",
    "backup": "tsx scripts/backup-db.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1043.0",
    "@aws-sdk/s3-request-presigner": "^3.1043.0",
    "@sentry/node": "^10.49.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "openai": "^6.34.0",
    "postgres": "^3.4.4",
    "qrcode": "^1.5.4",
    "recharts": "^3.8.1",
    "web-push": "^3.6.7",
    "ws": "^8.20.0",
    "zod": "^3.23.8"
